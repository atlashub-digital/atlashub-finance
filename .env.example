# ARO API environment template. Copy to .env for local dev only.
# Never commit real values. Production values are provisioned by Infrastructure
# (see docs/40_ARO_RUNTIME_RUNBOOK.md for the full list).
NODE_ENV=development
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info
ARO_VERSION=0.1.0
# Postgres DSN. Production: a LOGIN user in role aro_runtime on AtlasHub Supabase.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/aro_dev
ARO_PUBLIC_BASE_URL=http://localhost:8080
# >=32 random chars each; required in production (ephemeral in dev if unset).
ARO_CHECKOUT_SECRET_KEY=
ARO_OPERATOR_JWT_SECRET=
ARO_WORKER_ENABLED=true
ARO_CHECKOUT_RATE_LIMIT_PER_MIN=30
# Secrets by reference: ARO_SECRET_<CREDENTIAL_REF>__<FIELD>, e.g.
# ARO_SECRET_ARO_ATLASHUB_PIXGO_PROD__API_KEY=
# ARO_SECRET_ARO_ATLASHUB_PIXGO_PROD__WEBHOOK_SECRET=
# ARO_SECRET_ARO_ATLASHUB_MISTICPAY_PROD__CLIENT_ID=
# ARO_SECRET_ARO_ATLASHUB_MISTICPAY_PROD__CLIENT_SECRET=
# ARO_SECRET_ARO_ATLASHUB_STRIPE_PROD__SECRET_KEY=
# ARO_SECRET_ARO_ATLASHUB_STRIPE_PROD__WEBHOOK_SECRET=
# ARO_SECRET_ARO_ESPELHOMEU_WEBHOOK__SECRET=

# ARO Universal Checkout: manter false até Helena confirmar E2E/redirects/CSP/CRM
ARO_HOSTED_CHECKOUT_ENABLED=false

# Opt-in claim exchange: existing active project server API key (>=32 chars).
# Provision only after migration review; same key used by the consumer backend.
ARO_CLAIM_SERVER_KEY=
