# ARO API environment template. Copy to .env for local dev only.
# Never commit real values. Production values are provisioned by Infrastructure.
NODE_ENV=development
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info
ARO_VERSION=0.1.0
# Postgres DSN (AtlasHub Supabase in production). Required when NODE_ENV=production.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/aro_dev
