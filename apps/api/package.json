{
  "name": "@aro/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node dist/server.js",
    "dev": "node --watch --experimental-strip-types src/server.ts",
    "migrate": "node dist/migrate-cli.js"
  },
  "dependencies": {
    "@fastify/rate-limit": "11.2.1",
    "ajv": "8.20.0",
    "fastify": "5.12.7",
    "postgres": "3.4.9",
    "yaml": "2.9.1",
    "zod": "4.6.7",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@types/qrcode": "1.5.6"
  }
}
